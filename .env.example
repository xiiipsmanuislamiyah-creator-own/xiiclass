# Application base path (default: /xiiclass)
NEXT_PUBLIC_BASE_PATH=/xiiclass

# Admin session signing secret (change in production)
ADMIN_SECRET=change-this-to-a-random-secret

# Optional: Turso / libSQL Cloud Database (can also be configured from /admin UI)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Vercel API credentials for saving DB config from /admin UI
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
